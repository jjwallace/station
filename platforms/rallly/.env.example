# Rallly on Railway. Set these as service variables; don't commit real values.
# Source of truth for names: https://github.com/lukevella/rallly-selfhosted/blob/main/.env.example

# Public URL Rallly builds links against
NEXT_PUBLIC_BASE_URL=https://<rallly-domain>

# Random secret, min 32 chars: openssl rand -base64 32
SECRET_PASSWORD=

# Postgres, using its own database named "rallly".
# With a Railway Postgres service named "Postgres":
# DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/rallly
DATABASE_URL=

# Email: required, sign-in is by magic link
SUPPORT_EMAIL=
# NOREPLY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PWD=
SMTP_SECURE=false

# S3-compatible object storage (e.g. Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET_NAME=rallly
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: limit who can sign up, e.g. *@example.com
# ALLOWED_EMAILS=
# INITIAL_ADMIN_EMAIL=
